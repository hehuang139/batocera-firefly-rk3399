@@ -192,0 +193,18 @@
+def verify_dtb_power(path):
+    bus = '/i2c@ff3c0000'
+    consumers = [('/cpus/cpu@100', 'cpu-supply', '40', 'silergy,syr827'),
+                 ('/cpus/cpu@101', 'cpu-supply', '40', 'silergy,syr827'),
+                 ('/gpu@ff9a0000', 'mali-supply', '41', 'silergy,syr828')]
+    for consumer, supply, address, compatible in consumers:
+        rail = bus + '/regulator@' + address
+        actual = dtprop(path, consumer, supply, 'x')
+        check('dtb-supply:' + consumer, actual == dtprop(path, rail, 'phandle', 'x'), actual)
+        check('dtb-rail:' + consumer,
+              dtprop(path, rail, 'reg', 'x') == address and dtprop(path, rail, 'compatible') == compatible, rail)
+        bank = dtprop(path, rail, 'fcs,suspend-voltage-selector', 'u')
+        check('dtb-vsel:' + consumer, bank == '1', bank)
+        suspend = text(['fdtget', '-p', str(path), rail + '/regulator-state-mem']).splitlines()
+        check('dtb-suspend:' + consumer,
+              'regulator-off-in-suspend' in suspend and 'regulator-on-in-suspend' not in suspend, suspend)
+
+
@@ -194,0 +213 @@
+    verify_dtb_power(path)
